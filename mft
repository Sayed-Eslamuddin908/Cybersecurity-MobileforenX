_MFT_OBF="HichLikDKycsK2F7dQYY"
_MFT_KEY="MFXK"

_decode_password() {
    local decoded
    decoded=$(echo "${_MFT_OBF}" | base64 -d 2>/dev/null) || return 1
    local result=""
    local keylen=${#_MFT_KEY}
    local i=0
    while [[ $i -lt ${#decoded} ]]; do
        local c="${decoded:$i:1}"
        local k="${_MFT_KEY:$((i % keylen)):1}"
        local c_ord
        local k_ord
        c_ord=$(printf '%d' "'${c}")
        k_ord=$(printf '%d' "'${k}")
        result+=$(printf "\\$(printf '%03o' $(( c_ord ^ k_ord )))")
        i=$((i + 1))
    done
    echo -n "${result}"
}

