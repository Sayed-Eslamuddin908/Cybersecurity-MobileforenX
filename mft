}
step()  { echo -e "${BLUE}==>${NC} ${BOLD}$*${NC}"; }
ok()    { echo -e "${GREEN} ✓${NC} $*"; }
warn()  { echo -e "${YELLOW} ⚠${NC} $*"; }
fail()  { echo -e "${RED} ✗${NC} $*"; }
info()  { echo -e "${CYAN} ℹ${NC} $*"; }
die()   { fail "$*"; exit 1; }

# ═══════════════════════════════════════════════════════════════
#  1. AUTHOR VERIFICATION
# ═══════════════════════════════════════════════════════════════
verify_author() {
    step "Verifying author integrity"
    echo ""

    local errors=0
    local required_files=(
        "Mobileforenx.py" "web_interface.py" "content_extract.py"
        "forensic_report.py" "security_manager.py" "wireless_adb.py"
        "evidence_indexer.py" "evidence_browser.py"
        "root_artifact_extractor.py" "sqlite_carve.py"
        "Dockerfile" "requirements.txt" "entrypoint.sh"
    )

    grep -q "${AUTHOR_NAME}" "${BASH_SOURCE[0]}" 2>/dev/null \
        && ok "Launcher: author present" \
        || { fail "Launcher: author MISSING"; errors=$((errors + 1)); }

    local missing=()
    for f in "${required_files[@]}"; do
        [[ ! -f "${SCRIPT_DIR}/${f}" ]] && missing+=("$f")
    done

    if [[ ${#missing[@]} -eq 0 ]]; then
        ok "All ${#required_files[@]} core files present"
    else
        fail "Missing files: ${missing[*]}"; errors=$((errors + 1))
    fi

    for f in "Mobileforenx.py" "web_interface.py" "Dockerfile"; do
        if [[ -f "${SCRIPT_DIR}/${f}" ]] && grep -qi "${AUTHOR_NAME}" "${SCRIPT_DIR}/${f}" 2>/dev/null; then
            ok "Author in ${f}"
        fi
    done

    echo ""
    if [[ ${errors} -gt 0 ]]; then
        fail "═══════════════════════════════════════════════════════════"
        fail "  AUTHOR VERIFICATION FAILED — ${errors} error(s)"
        fail "═══════════════════════════════════════════════════════════"
        exit 1
    fi
    ok "Author verification passed — ${AUTHOR_NAME}"
    echo ""
}

# ═══════════════════════════════════════════════════════════════
#  2. AUTO-UPDATE
# ═══════════════════════════════════════════════════════════════
check_for_updates() {
    step "Checking for updates"

    [[ "${MFX_NO_UPDATE:-0}" == "1" ]] && { info "Update skipped"; return 0; }
    [[ ! -f "${SCRIPT_DIR}/${LOCAL_VERSION_FILE}" ]] && { warn "version.json not found"; return 0; }
    ! command -v curl >/dev/null 2>&1 && { warn "curl not installed"; return 0; }

    local stamp="${SCRIPT_DIR}/${STAMP_FILE}"
    if [[ "${FORCE_UPDATE:-0}" != "1" ]] && [[ -f "${stamp}" ]]; then
        local last now elapsed
        last=$(cat "${stamp}" 2>/dev/null || echo 0)
        now=$(date +%s)
        elapsed=$((now - last))
        if (( elapsed < UPDATE_CHECK_INTERVAL )); then
            info "Update throttled"
            return 0
        fi
    fi

    local local_version remote_url repo
    local_version=$(grep -oP '"version"\s*:\s*"\K[^"]+' "${SCRIPT_DIR}/${LOCAL_VERSION_FILE}" | head -1 || true)
    remote_url=$(grep -oP '"update_manifest_url"\s*:\s*"\K[^"]+' "${SCRIPT_DIR}/${LOCAL_VERSION_FILE}" | head -1 || true)
    repo=$(grep -oP '"github_repo"\s*:\s*"\K[^"]+' "${SCRIPT_DIR}/${LOCAL_VERSION_FILE}" | head -1 || true)

    [[ -z "${local_version}" || -z "${remote_url}" ]] && return 0

    info "Local version:  ${local_version}"
    echo ""

    local tmp_manifest
    tmp_manifest=$(mktemp)

    if ! curl -fsSL --max-time 10 -o "${tmp_manifest}" "${remote_url}" 2>/dev/null; then
        warn "Cannot reach update server"
        date +%s > "${stamp}"
        rm -f "${tmp_manifest}"
        return 0
    fi

    local remote_version
    remote_version=$(grep -oP '"version"\s*:\s*"\K[^"]+' "${tmp_manifest}" | head -1 || true)
    [[ -z "${remote_version}" ]] && { date +%s > "${stamp}"; rm -f "${tmp_manifest}"; return 0; }

    if [[ "${local_version}" == "${remote_version}" ]]; then
        ok "Already up to date (v${local_version})"
        date +%s > "${stamp}"
        rm -f "${tmp_manifest}"
        echo ""
        return 0
    fi

    echo -e "${YELLOW}${BOLD}  ⚡ New version: v${remote_version}${NC}"

    local reply="Y"
    if [[ -t 0 ]]; then
        read -p "  Update now? [Y/n]: " -r reply
        reply="${reply:-Y}"
    fi

    if [[ "${reply}" =~ ^[Yy]$ ]]; then
        apply_update "${repo}" "${remote_version}" "${tmp_manifest}"
    fi

    date +%s > "${stamp}"
    rm -f "${tmp_manifest}"
    echo ""
}

apply_update() {
    local repo="$1"; local version="$2"; local manifest="$3"
    step "Applying update to v${version}"

    local backup="${SCRIPT_DIR}/.backup_pre_update"
    rm -rf "${backup}"; mkdir -p "${backup}"

    local files_raw
    files_raw=$(grep -oP '"files_to_update"\s*:\s*\[\K[^\]]+' "${manifest}" | tr -d '"' | tr ',' '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' || true)
    [[ -z "${files_raw}" ]] && return 1

    local updated=0 failed=0
    while IFS= read -r relpath; do
        [[ -z "${relpath}" ]] && continue
        local local_file="${SCRIPT_DIR}/${relpath}"
        local remote_file="https://raw.githubusercontent.com/${repo}/main/${relpath}"

        [[ -f "${local_file}" ]] && { mkdir -p "${backup}/$(dirname "${relpath}")"; cp "${local_file}" "${backup}/${relpath}" 2>/dev/null || true; }
        mkdir -p "$(dirname "${local_file}")"

        if curl -fsSL --max-time 30 -o "${local_file}.new" "${remote_file}" 2>/dev/null; then
            if grep -qi "${AUTHOR_NAME}" "${local_file}.new" 2>/dev/null; then
                mv "${local_file}.new" "${local_file}"
                ok "  ✓ ${relpath}"
                updated=$((updated + 1))
            else
                warn "  ⚠ ${relpath} missing author"
                rm -f "${local_file}.new"
                failed=$((failed + 1))
            fi
        else
            rm -f "${local_file}.new"
            failed=$((failed + 1))
        fi
    done <<< "${files_raw}"

    echo ""
    ok "Update complete — ${updated} updated, ${failed} failed"
    echo ""
}

# ═══════════════════════════════════════════════════════════════
#  3. SYSTEM DEPENDENCIES
# ═══════════════════════════════════════════════════════════════
check_deps() {
    step "Checking system dependencies"

    if command -v apt-get >/dev/null 2>&1; then
        PKG_MGR="apt"; PKG_INSTALL="sudo apt-get install -y"; PKG_UPDATE="sudo apt-get update"
    elif command -v dnf >/dev/null 2>&1; then
        PKG_MGR="dnf"; PKG_INSTALL="sudo dnf install -y"; PKG_UPDATE=""
    elif command -v pacman >/dev/null 2>&1; then
        PKG_MGR="pacman"; PKG_INSTALL="sudo pacman -S --noconfirm"; PKG_UPDATE=""
    else
        PKG_MGR="unknown"; warn "Unknown package manager"
    fi

    NEED_INSTALL=()

    if command -v podman >/dev/null 2>&1; then
        CONTAINER_ENGINE="podman"; ok "podman $(podman --version | awk '{print $3}')"
    elif command -v docker >/dev/null 2>&1; then
        CONTAINER_ENGINE="docker"; ok "docker $(docker --version | awk '{print $3}' | tr -d ',')"
    else
        warn "podman NOT installed"; NEED_INSTALL+=("podman")
    fi

    local tools=(
        "adb:android-tools-adb:ADB"
        "openssl:openssl:openssl"
        "curl:curl:curl"
        "python3:python3:python3"
        "pip3:python3-pip:python3-pip"
        "python3-venv:python3-venv:python3-venv"
        "lsusb:usbutils:usbutils"
    )

    for entry in "${tools[@]}"; do
        IFS=':' read -r cmd pkg desc <<< "$entry"
        if command -v "${cmd}" >/dev/null 2>&1; then
            ok "${cmd} available"
        else
            warn "${cmd} NOT installed — ${desc}"
            [[ ! " ${NEED_INSTALL[*]} " =~ " ${pkg} " ]] && NEED_INSTALL+=("${pkg}")
        fi
    done

    echo ""

    if [[ ${#NEED_INSTALL[@]} -gt 0 ]]; then
        warn "Missing: ${NEED_INSTALL[*]}"
        [[ "${PKG_MGR}" == "unknown" ]] && die "Unknown package manager"

        local reply="Y"
        if [[ -t 0 ]]; then
            read -p "  Install now? [Y/n]: " -r reply
            reply="${reply:-Y}"
        fi

        if [[ "${reply}" =~ ^[Yy]$ ]]; then
            step "Installing system packages"
            [[ -n "${PKG_UPDATE}" ]] && { info "Updating index..."; ${PKG_UPDATE} || die "Update failed"; }
            for pkg in "${NEED_INSTALL[@]}"; do
                info "Installing ${pkg}..."
                ${PKG_INSTALL} "${pkg}" || warn "Failed: ${pkg}"
            done
            ok "System install complete"
            command -v podman >/dev/null 2>&1 && CONTAINER_ENGINE="podman"
            [[ -z "${CONTAINER_ENGINE:-}" ]] && command -v docker >/dev/null 2>&1 && CONTAINER_ENGINE="docker"
        else
            die "Cannot proceed"
        fi
    fi

    if [[ "${CONTAINER_ENGINE:-}" == "podman" ]]; then
        if ! systemctl is-active --quiet podman.socket 2>/dev/null; then
            systemctl list-unit-files 2>/dev/null | grep -q "podman.socket" && \
                sudo systemctl enable --now podman.socket 2>/dev/null || true
        fi
    fi

    export CONTAINER_ENGINE
    echo ""
    ok "System dependencies satisfied"
    echo ""
}

# ═══════════════════════════════════════════════════════════════
#  4. PYTHON PACKAGES (HOST + CONTAINER) — FULL INSTALLER
# ═══════════════════════════════════════════════════════════════
install_python_packages() {
    step "Checking Python packages"
    echo ""

    # ─── 1. Ensure pip3 exists ───
    if ! command -v pip3 >/dev/null 2>&1; then
        warn "pip3 not installed — installing"
        case "${PKG_MGR:-unknown}" in
            apt)    sudo apt-get install -y python3-pip python3-venv 2>/dev/null || warn "Failed" ;;
            dnf)    sudo dnf install -y python3-pip 2>/dev/null || warn "Failed" ;;
            pacman) sudo pacman -S --noconfirm python-pip 2>/dev/null || warn "Failed" ;;
        esac
    fi

    command -v pip3 >/dev/null 2>&1 && ok "pip3 available" || warn "pip3 unavailable"
    echo ""

    # ─── 2. Check which packages are missing on host ───
    local missing_host=()
    local missing_names=()
    for i in "${!IMPORT_NAMES[@]}"; do
        local import_name="${IMPORT_NAMES[$i]}"
        local pypi_name="${PYPI_NAMES[$i]}"
        if ! python3 -c "import ${import_name}" 2>/dev/null; then
            missing_names+=("${pypi_name}")
        fi
    done

    if [[ ${#missing_names[@]} -eq 0 ]]; then
        ok "All host Python packages present"
    else
        warn "Missing on host: ${missing_names[*]}"
        echo ""

        local reply="Y"
        if [[ -t 0 ]]; then
            read -p "  Install on host? [Y/n]: " -r reply
            reply="${reply:-Y}"
        fi

        if [[ "${reply}" =~ ^[Yy]$ ]]; then
            step "Installing host packages (1-3 min)"
            echo ""

            # ─── Try methods in order ───
            local installed=0

            # Method 1: user install
            info "Attempting: pip3 install --user..."
            if pip3 install --user -q "${missing_names[@]}" 2>&1 | tail -2; then
                installed=1
            fi

            # Method 2: break-system-packages
            if [[ ${installed} -eq 0 ]]; then
                warn "Retrying with --break-system-packages..."
                if pip3 install --user --break-system-packages -q "${missing_names[@]}" 2>&1 | tail -2; then
                    installed=1
                fi
            fi

            # Method 3: venv fallback
            if [[ ${installed} -eq 0 ]]; then
                warn "Retrying with venv at ${VENV_DIR}..."
                if [[ ! -d "${VENV_DIR}" ]]; then
                    python3 -m venv "${VENV_DIR}" 2>/dev/null || true
                fi
                if [[ -f "${VENV_DIR}/bin/pip" ]]; then
                    "${VENV_DIR}/bin/pip" install -q --upgrade pip 2>/dev/null || true
                    if "${VENV_DIR}/bin/pip" install -q "${missing_names[@]}" 2>&1 | tail -2; then
                        installed=1
                        info "Installed in venv: ${VENV_DIR}"
                    fi
                fi
            fi

            if [[ ${installed} -eq 1 ]]; then
                ok "Host install complete"
            else
                warn "Host install failed — container will still work"
            fi
            echo ""
        fi
    fi
    echo ""

    # ─── 3. Verify container packages ───
    if ! image_exists 2>/dev/null; then
        info "Image not built yet — will verify after build"
        echo ""
        return 0
    fi

    echo "── Verifying container packages:"
    echo ""

    local missing_container=()
    for i in "${!IMPORT_NAMES[@]}"; do
        local import_name="${IMPORT_NAMES[$i]}"
        local pkg_name="${PYTHON_PACKAGES[$i]:-${import_name}}"

        if sudo ${CONTAINER_ENGINE} run --rm "${IMAGE_NAME}:latest" \
            python3 -c "import ${import_name}" >/dev/null 2>&1; then
            ok "  ${pkg_name} ✅"
        else
            warn "  ${pkg_name} MISSING"
            missing_container+=("${pkg_name}")
        fi
    done
    echo ""

    if [[ ${#missing_container[@]} -gt 0 ]]; then
        warn "Missing in container: ${missing_container[*]}"
        info "Rebuilding image..."
        echo ""
        build_image || die "Rebuild failed"
        ok "Image rebuilt"
    else
        ok "All container packages present"
    fi
    echo ""
}

# ═══════════════════════════════════════════════════════════════
#  5. BUILD / RUN
# ═══════════════════════════════════════════════════════════════
build_image() {
    step "Building container image '${IMAGE_NAME}:latest'"
    cd "${SCRIPT_DIR}"

    [[ -f Dockerfile ]]       || die "Dockerfile not found"
    [[ -f requirements.txt ]] || die "requirements.txt not found"

    echo ""
    info "This takes 2-5 minutes on first run"
    echo ""

    sudo ${CONTAINER_ENGINE} build --no-cache -t "${IMAGE_NAME}:latest" . || die "Build failed"
    ok "Image built successfully"
    echo ""
}

image_exists() {
    sudo ${CONTAINER_ENGINE} image exists "${IMAGE_NAME}:latest" 2>/dev/null
}

stop_container() {
    if sudo ${CONTAINER_ENGINE} ps -a --format '{{.Names}}' 2>/dev/null | grep -q "^${CONTAINER_NAME}$"; then
        step "Stopping old container"
        sudo ${CONTAINER_ENGINE} rm -f "${CONTAINER_NAME}" 2>/dev/null || true
        ok "Old container removed"
    fi
}

open_browser() {
    (
        sleep 4
        for cmd in xdg-open firefox-esr firefox google-chrome chromium; do
            if command -v "${cmd}" >/dev/null 2>&1; then
                nohup "${cmd}" "${APP_URL}" >/dev/null 2>&1 &
                break
            fi
        done
    ) &
}

# ═══════════════════════════════════════════════════════════════
#  DEFENCY
# ═══════════════════════════════════════════════════════════════
generate_defency() {
    step "Generating 'defency' report"

    local out="${SCRIPT_DIR}/${DEFENCY_FILE}"
    local tmp
    tmp=$(mktemp)

    {
        echo "════════════════════════════════════════════════════════════════"
        echo "  MOBILEFORENX — DEFENCY REPORT"
        echo "════════════════════════════════════════════════════════════════"
        echo ""
        echo "Author:         ${AUTHOR_NAME}"
        echo "Generated:      $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
        echo "Hostname:       $(hostname)"
        echo ""

        echo "── ENCRYPTION ──"
        local enc_count=0 clean_count=0
        for f in "${SCRIPT_DIR}"/*.py; do
            [[ ! -f "$f" ]] && continue
            if grep -q "PEGASUS_PASSWORD\|_BLOB" "$f" 2>/dev/null; then
                enc_count=$((enc_count + 1))
            else
                clean_count=$((clean_count + 1))
            fi
        done
        echo "  Encrypted:  ${enc_count}"
        echo "  Clean:      ${clean_count}"
        echo "  Password:   Auto-injected ✅"
        echo ""

        echo "── HOST PYTHON PACKAGES ──"
        for i in "${!IMPORT_NAMES[@]}"; do
            local import_name="${IMPORT_NAMES[$i]}"
            local pkg_name="${PYTHON_PACKAGES[$i]:-${import_name}}"
            if python3 -c "import ${import_name}" 2>/dev/null; then
                printf "  ✓ %-20s installed\n" "${pkg_name}"
            else
                printf "  ✗ %-20s MISSING\n" "${pkg_name}"
            fi
        done
        echo ""

        echo "── CONTAINER PYTHON PACKAGES ──"
        if image_exists; then
            for i in "${!IMPORT_NAMES[@]}"; do
                local import_name="${IMPORT_NAMES[$i]}"
                local pkg_name="${PYTHON_PACKAGES[$i]:-${import_name}}"
                if sudo ${CONTAINER_ENGINE} run --rm "${IMAGE_NAME}:latest" python3 -c "import ${import_name}" >/dev/null 2>&1; then
                    printf "  ✓ %-20s installed\n" "${pkg_name}"
                else
                    printf "  ✗ %-20s MISSING\n" "${pkg_name}"
                fi
            done
        else
            echo "  (image not built)"
        fi
        echo ""

        echo "── RUNTIME ──"
        echo "  Port:   ${HOST_PORT}"
        echo "  URL:    ${APP_URL}"
        echo "  User:   ${MFX_USER}"
        echo ""

        echo "── INTEGRITY ──"
        echo "  Author: ${AUTHOR_NAME}"
        echo "  Report ID: $(date +%s)-$RANDOM"
        echo ""
        echo "════════════════════════════════════════════════════════════════"
        echo "  END OF DEFENCY REPORT"
        echo "════════════════════════════════════════════════════════════════"
    } > "${tmp}"

    local body_hash
    body_hash=$(sha256sum "${tmp}" | awk '{print $1}')
    {
        cat "${tmp}"
        echo ""
        echo "Report SHA-256: ${body_hash}"
    } > "${out}"

    rm -f "${tmp}"
    ok "Defency report: ${out}"
    echo ""
}

show_defency() {
    [[ ! -f "${SCRIPT_DIR}/${DEFENCY_FILE}" ]] && generate_defency
    echo ""
    cat "${SCRIPT_DIR}/${DEFENCY_FILE}"
    echo ""
}

